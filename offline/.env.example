# Kopieren nach .env und Werte eintragen (.env ist gitignored — Key bleibt lokal!)

# OpenWebUI auf dem Homelab (nur Host + Port; der Container erreicht es über den llm-Proxy):
OPENWEBUI_HOST=192.168.1.50
OPENWEBUI_PORT=8080
OPENWEBUI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Projektordner, auf dem opencode arbeiten soll:
# OPENCODE_WORKSPACE=C:\Users\du\mein-projekt
